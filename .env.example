# Sitio Wapi — variables de build (Vite solo expone las que empiezan con VITE_).
# Las del proceso (CI, línea de comandos) pisan a las de estos archivos.

# Feature flag del lanzamiento.
#   false → se publica la página "en desarrollo" (la que está hoy en wapidesign.com).
#   true  → se publica el sitio nuevo.
VITE_SITIO_NUEVO=false

# Dominio público, sin barra final. Lo usan los canonical, el Open Graph y el sitemap.
VITE_SITE_URL=https://www.wapidesign.com

# Ambientes que no son producción (DEV): true = todas las páginas noindex, robots.txt con
# Disallow: / y sin sitemap. Lo setea deploy-dev.yml.
VITE_NOINDEX=false
