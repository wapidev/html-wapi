# Build de producción (`npm run build`).
# LANZAMIENTO: pasar VITE_SITIO_NUEVO a true en un PR y mergearlo hasta main (deploy-prod.yml publica).
# Mientras esté en false, dist/ trae solo la página "en desarrollo" (sin JS ni contenido del sitio nuevo).
VITE_SITIO_NUEVO=false
VITE_SITE_URL=https://www.wapidesign.com
